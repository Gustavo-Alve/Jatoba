
<div class="container">
    <%= form_with url: login_path, method: :post, class: "formulario" do |form| %>

        <h1>Login</h1>
        <p>Entre com suas credenciais</p>

        <div class="campo">
            <%= form.label :usuario, "Usuário" %>

            <%= form.text_field :usuario,
                placeholder: "Digite seu usuário",
                autocomplete: "username",
                required: true%>
        </div>

        <div class="campo">
            <%= form.label :senha, "Senha" %>

            <%= form.password_field :senha,
                placeholder: "Digite sua senha",
                autocomplete: "current-password",
                required: true %>
        </div>

        <div class="novo_cadastro">
            <%= link_to "Criar conta", new_users_path %>
        </div>

        <%= form.submit "Entrar" %>

    <% end %>
</div>
